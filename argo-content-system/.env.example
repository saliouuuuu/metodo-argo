# Argo Content System — variabili d'ambiente (copiare in .env, MAI committare)
# Nessuna di queste è necessaria per la modalità semi-auto attuale.

# Stadio 2 — Metricool (quando attivato)
METRICOOL_API_KEY=
METRICOOL_BLOG_ID=

# Stadio 3 — TikTok Content Posting API (quando l'app sarà auditata)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Adapter voice-over (facoltativi)
ELEVENLABS_API_KEY=

# Adapter video AI (facoltativi)
HIGGSFIELD_API_KEY=
