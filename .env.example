# ============================================================
# IL METODO ARGO — Variabili d'ambiente
# Copia questo file in `.env` per lo sviluppo locale (netlify dev)
# e imposta le stesse variabili su Netlify: Site settings →
# Environment variables. MAI committare il file .env.
# ============================================================

# --- Supabase (Project settings → API) ---
# URL del progetto (pubblico)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chiave "anon" (pubblica, protetta da Row Level Security)
SUPABASE_ANON_KEY=eyJ...
# Chiave "service_role" (SEGRETA — solo nelle funzioni server)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe (Developers → API keys) ---
# Chiave segreta (sk_test_... in test, sk_live_... in produzione)
STRIPE_SECRET_KEY=sk_test_...
# Signing secret del webhook (Developers → Webhooks → endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID del Metodo Argo (€47) — Products → prezzo → API ID
STRIPE_PRICE_METODO=price_...
# Price ID dell'order bump "Checklist arrivo cucciolo" (€9)
STRIPE_PRICE_BUMP=price_...

# --- Sito ---
# URL pubblico del sito (senza slash finale)
SITE_URL=https://ilmetodoargo.netlify.app
